# Copy to .env (never commit). Read from the process environment by the API.
ROOSTTRACKER_HOST=127.0.0.1
ROOSTTRACKER_PORT=8765
# Directory containing events.json and per-event manifests/assets (outside version control in production)
ROOSTTRACKER_DATA_DIR=web/demo
# Future: DATABASE_URL, EBIRD_API_KEY (server-side only; not used by this MVP)
